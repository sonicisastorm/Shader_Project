{
  "name": "shader-kit",
  "version": "1.0.0",
  "description": "Student shader project — Three.js + custom GLSL",
  "type": "module",
  "main": "./src/App.js",
  "exports": {
    ".": "./src/App.js",
    "./camera": "./src/camera/Camera.js",
    "./controls": "./src/controls/CameraController.js",
    "./postprocessing": "./src/postprocessing/PostProcessor.js",
    "./scene": "./src/scene/SceneManager.js",
